/* Main CSS */
#main-layout {
	height: 1fr;
}

/* Sidebar */
#platform-sidebar {
	width: 30;
	background: $surface-darken-1;
	border-right: solid $border;
	padding: 1;
}

#sidebar-title {
	text-style: bold;
	margin-bottom: 1;
	text-align: center;
	color: $accent;
}

/* Platform Info Section */
#platform-info {
	padding: 1;
	height: 1fr;
}

#roms-table {
	height: 1fr;
	border: solid $border;
	margin-bottom: 1;
}

/* System Log Modal */
SystemLogModal {
	align: center middle;
}

SystemLogModal > Container {
	width: auto;
	height: auto;
}

SystemLogModal > Container > Horizontal {
	width: auto;
	height: auto;
}

#log-modal-panel {
	width: 70%;
	height: 70%;
	min-width: 60;
	background: $surface;
	border: double $accent;
	padding: 1 2;
}

#system-rich-log {
	height: 1fr;
	border: solid $border;
	background: $surface-darken-2;
	margin-bottom: 1;
}
