/* Main CSS */
#main-layout {
	height: 1fr;
}

/* Sidebar */
#platform-sidebar {
	width: auto;
	min-width: 25;
	max-width: 45;
	background: $surface-darken-1;
	border-right: solid $border;
	padding: 1;
}

#sidebar-title {
	text-style: bold;
	margin-bottom: 1;
	text-align: center;
	color: $accent;
}

/* Platform Info Section */
#platform-info {
	padding: 1;
	height: 1fr;
}

#roms-table {
	height: 1fr;
	border: solid $border;
	margin-bottom: 1;
}

/* Modals */
ModalScreen {
	align: center middle;
}

ModalScreen > Container {
	width: auto;
	height: auto;
}

ModalScreen > Container > Horizontal {
	width: auto;
	height: auto;
}

.modal-panel {
	width: 70%;
	height: 70%;
	min-width: 60;
	background: $surface;
	border: double $accent;
	padding: 1 2;
}

/* System Log Modal */
#system-rich-log {
	height: 1fr;
	border: solid $border;
	background: $surface-darken-2;
	margin-bottom: 1;
}

/* Filters */
#media-filter-container {
	height: auto;
	margin-bottom: 1;
	background: $surface-darken-1;
	border: solid $border;
	align: center middle;
	padding: 0 2;
}

#media-filter-container Checkbox {
	margin-right: 4;
}

/* Buttons */
.button-group {
	height: auto;
}

.button-group Button {
	margin-right: 1;
}
